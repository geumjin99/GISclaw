# GISclaw — optional environment configuration.
#
# You do NOT need this file: API keys can be pasted in the app under
# Settings → API keys…, where they are stored server-side in
# ./projects/.gisclaw/settings.json (mode 600) and survive image rebuilds.
#
# Use this file instead if you prefer keys to come from the environment
# (CI, shared hosts, secret managers). Values here act as the fallback.

# OpenAI                      https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude)          https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# DeepSeek — cheapest, good for trying things out
DEEPSEEK_API_KEY=

# Google Gemini               https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: an extra local skills directory to load bundles from.
# Never point this at someone else's skill collection in a published image.
# GISCLAW_EXTRA_SKILLS=/path/to/skills

# Optional: workspace root inside the container (default /workspace).
# GISCLAW_WORKSPACE=/workspace
